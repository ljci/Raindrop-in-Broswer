{
  "manifest_version": 3,
  "name": "Raindrop Quick Links",
  "version": "1.0.1",
  "description": "One Raindrop folder (and its subfolders) one click away. Loaded live; nothing is saved as browser bookmarks.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Raindrop Quick Links",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html",
  "permissions": ["storage", "favicon"],
  "host_permissions": ["https://api.raindrop.io/*"],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+R",
        "mac": "Alt+R"
      },
      "description": "Open Raindrop Quick Links"
    }
  }
}
